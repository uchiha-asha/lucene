From b3aa8f3a2469d49eaaedfdd3cf072663a4e40075 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 12:26:20 +0000
Subject: [PATCH] Speed up DocIdSetBuilder#build when doc IDs are clustered

The radix sort that DocIdSetBuilder uses for sparse sets sorts as many bits as maxDoc
requires. When all doc IDs are in a small range of the doc ID space, e.g. for a range
query on a timestamp field against a segment whose docs got indexed in timestamp order,
sorting deltas from the min doc ID requires fewer passes.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EozJPtiJsJKEVATGbxEknG
---
 .../apache/lucene/util/DocIdSetBuilder.java   | 49 ++++++++++++++++++-
 .../lucene/util/TestDocIdSetBuilder.java      | 46 +++++++++++++++++
 2 files changed, 93 insertions(+), 2 deletions(-)

diff --git a/lucene/core/src/java/org/apache/lucene/util/DocIdSetBuilder.java b/lucene/core/src/java/org/apache/lucene/util/DocIdSetBuilder.java
index c8f5aebca..1197faad2 100644
--- a/lucene/core/src/java/org/apache/lucene/util/DocIdSetBuilder.java
+++ b/lucene/core/src/java/org/apache/lucene/util/DocIdSetBuilder.java
@@ -318,8 +318,7 @@ public final class DocIdSetBuilder {
         return new BitDocIdSet(bitSet, cost);
       } else {
         Buffer concatenated = concat(buffers);
-        LSBRadixSorter sorter = new LSBRadixSorter();
-        sorter.sort(PackedInts.bitsRequired(maxDoc - 1), concatenated.array, concatenated.length);
+        sort(concatenated.array, concatenated.length);
         final int l;
         if (multivalued) {
           l = dedup(concatenated.array, concatenated.length);
@@ -367,6 +366,52 @@ public final class DocIdSetBuilder {
     return new Buffer(docs, totalLength);
   }
 
+  /** Sort {@code docs[0:length]} in ascending order. */
+  private void sort(int[] docs, int length) {
+    LSBRadixSorter sorter = new LSBRadixSorter();
+    final int numBits = PackedInts.bitsRequired(maxDoc - 1);
+    if (length == 0) {
+      return;
+    }
+    // The cost of the radix sort is proportional to the number of bits of the values to sort. Doc
+    // IDs are often clustered in a small range of the doc ID space, e.g. when a range query on a
+    // timestamp runs against a segment whose documents got indexed in (approximate) timestamp
+    // order, or when the index is sorted. So we sort deltas from the minimum doc ID rather than
+    // doc IDs if this saves sorting passes.
+    final int numPasses = numRadixSortPasses(numBits);
+    int min = docs[0];
+    int max = docs[0];
+    // The range of doc IDs can only grow as we look at more doc IDs, so stop looking at doc IDs
+    // as soon as we know that sorting deltas would not save passes. This way doc IDs that are
+    // scattered across the doc ID space only pay for looking at the first few of them.
+    for (int from = 1;
+        from < length && numRadixSortPasses(PackedInts.bitsRequired(max - min)) < numPasses; ) {
+      final int to = Math.min(length, from + 64);
+      for (; from < to; ++from) {
+        final int doc = docs[from];
+        min = Math.min(min, doc);
+        max = Math.max(max, doc);
+      }
+    }
+    final int numDeltaBits = PackedInts.bitsRequired(max - min);
+    if (numRadixSortPasses(numDeltaBits) < numPasses) {
+      for (int i = 0; i < length; ++i) {
+        docs[i] -= min;
+      }
+      sorter.sort(numDeltaBits, docs, length);
+      for (int i = 0; i < length; ++i) {
+        docs[i] += min;
+      }
+    } else {
+      sorter.sort(numBits, docs, length);
+    }
+  }
+
+  /** Number of passes that {@link LSBRadixSorter}, which sorts 8 bits at a time, needs. */
+  private static int numRadixSortPasses(int numBits) {
+    return (numBits + 7) >>> 3;
+  }
+
   private static int dedup(int[] arr, int length) {
     if (length == 0) {
       return 0;
diff --git a/lucene/core/src/test/org/apache/lucene/util/TestDocIdSetBuilder.java b/lucene/core/src/test/org/apache/lucene/util/TestDocIdSetBuilder.java
index 1f661be3f..1cf33497d 100644
--- a/lucene/core/src/test/org/apache/lucene/util/TestDocIdSetBuilder.java
+++ b/lucene/core/src/test/org/apache/lucene/util/TestDocIdSetBuilder.java
@@ -69,6 +69,52 @@ public class TestDocIdSetBuilder extends LuceneTestCase {
     assertEquals(new BitDocIdSet(ref), result);
   }
 
+  /** Doc IDs that are clustered in a small range of the doc ID space, in random order. */
+  public void testSparseClustered() throws IOException {
+    for (int iter = 0; iter < 10; ++iter) {
+      final int maxDoc = TestUtil.nextInt(random(), 1 << 16, 1 << 26);
+      // sometimes cross a boundary where a high byte of doc IDs changes
+      final int rangeStart =
+          random().nextBoolean()
+              ? random().nextInt(maxDoc)
+              : Math.max(0, (1 << TestUtil.nextInt(random(), 8, 25)) - random().nextInt(300));
+      final int rangeLength =
+          Math.min(
+              maxDoc - rangeStart,
+              1 << TestUtil.nextInt(random(), 0, random().nextBoolean() ? 9 : 20));
+      if (rangeStart >= maxDoc) {
+        continue;
+      }
+      final boolean multiValued = random().nextBoolean();
+      // few enough doc IDs that the builder does not upgrade to a bit set, even with duplicates
+      final int numDocs = Math.min((maxDoc >>> 7) / 4, TestUtil.nextInt(random(), 1, 3000));
+      DocIdSetBuilder builder =
+          multiValued ? new DocIdSetBuilder(maxDoc) : new DocIdSetBuilder(maxDoc, numDocs, numDocs);
+      final FixedBitSet ref = new FixedBitSet(maxDoc);
+      int numAdded = 0;
+      while (numAdded < numDocs) {
+        int batchSize = TestUtil.nextInt(random(), 1, numDocs - numAdded);
+        DocIdSetBuilder.BulkAdder adder = builder.grow(batchSize);
+        for (int i = 0; i < batchSize; ++i) {
+          int doc = rangeStart + random().nextInt(rangeLength);
+          if (multiValued == false && ref.get(doc)) {
+            // no duplicates allowed, take the next free doc ID
+            doc = ref.nextClearBit(rangeStart);
+            if (doc >= rangeStart + rangeLength) {
+              break;
+            }
+          }
+          adder.add(doc);
+          ref.set(doc);
+        }
+        numAdded += batchSize;
+      }
+      DocIdSet result = builder.build();
+      assertTrue(result instanceof IntArrayDocIdSet);
+      assertEquals(new BitDocIdSet(ref), result);
+    }
+  }
+
   public void testDense() throws IOException {
     final int maxDoc = 1000000 + random().nextInt(1000000);
     DocIdSetBuilder builder = new DocIdSetBuilder(maxDoc);
