--- a/lucene/core/src/test/org/apache/lucene/search/TestConstantScoreBulkScorer.java
+++ b/lucene/core/src/test/org/apache/lucene/search/TestConstantScoreBulkScorer.java
@@ -195,6 +195,129 @@ public class TestConstantScoreBulkScorer extends LuceneTestCase {
